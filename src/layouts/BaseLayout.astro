---
import { ClientRouter, fade } from 'astro:transitions';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { kontakt } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: ImageMetadata;
}

const {
  title,
  description = 'Radovan Kulich – fotograf a videomaker z Prostějova. Svatby, plesy, sport, festivaly, komerční a školní focení.',
  ogImage,
} = Astro.props;

const fullTitle = title ? `${title} – ${kontakt.jmeno}` : `${kontakt.jmeno} – fotograf a videomaker, Prostějov`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = ogImage
  ? await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })
  : undefined;
const ogUrl = og ? new URL(og.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* TODO: odstranit noindex, až web poběží na kořeni místo /novy/ */}
    <meta name="robots" content="noindex" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={kontakt.jmeno} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="any" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
    <meta name="theme-color" content="#fafafa" />

    <script is:inline>
      document.documentElement.classList.add('js');
      // View transitions přepisují atributy <html>, třídu je nutné vrátit hned po výměně
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link mono" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah" transition:animate={fade({ duration: '200ms' })}>
      <slot />
    </main>
    <Footer />

    <script>
      import { initPage } from '../scripts/page';

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 0.75rem;
    background: var(--fg);
    color: var(--bg);
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
